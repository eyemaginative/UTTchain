# UTTchain local environment template.
#
# Copy this file to .env only when local network configuration is needed.
# .env is ignored by Git.
#
# NEVER store:
# - private keys
# - seed phrases
# - production CEX credentials
# - wallet recovery material
# - other signing secrets
# in this repository.

ROBINHOOD_TESTNET_CHAIN_ID=46630
ROBINHOOD_MAINNET_CHAIN_ID=4663

ROBINHOOD_TESTNET_RPC_URL=
ROBINHOOD_MAINNET_RPC_URL=
